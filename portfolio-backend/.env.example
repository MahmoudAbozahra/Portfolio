NODE_ENV=development
PORT=5000
HOST=127.0.0.1
MONGODB_URI=mongodb://127.0.0.1:27017/portfolio
# Optional Atlas fallback when the network blocks DNS TXT queries.
MONGODB_DIRECT_HOSTS=
CORS_ORIGINS=http://localhost:5173
SESSION_COOKIE_NAME=portfolio_session
SESSION_COOKIE_SECURE=false
SESSION_COOKIE_SAME_SITE=lax
SESSION_COOKIE_DOMAIN=
SESSION_TTL_HOURS=8
UPLOADS_DIR=./uploads
MAX_IMAGE_BYTES=5242880
MAX_IMAGE_COUNT=10
ALLOW_PORTFOLIO_RESET=false
ADMIN_USERNAME=admin@example.com
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=Replace-With-A-Strong-Unique-Password-123
